<?php
// تفعيل التخزين المؤقت لمنع أي مشاكل في الـ Headers
ob_start();

session_start();
require_once __DIR__ . '/config/db.php';
require_once __DIR__ . '/includes/functions.php';
require_once __DIR__ . '/includes/auth.php';

if (!is_logged_in()) {
    header("Location: " . base_url('login.php'));
    exit();
}

$curUser = current_user();
$userEmail = $curUser['email'] ?? $_SESSION['user']['email'] ?? $_SESSION['email'] ?? '';
$userRole = $curUser['role'] ?? $_SESSION['role'] ?? '';
$isAr = (isset($_SESSION['lang']) && $_SESSION['lang'] === 'ar');

$lesson_id = (int)($_GET['id'] ?? 0);

if ($lesson_id <= 0) {
    header("Location: instructor_dashboard.php");
    exit();
}

// جلب بيانات الدرس مع الكورس التابع له للتحقق من الصلاحيات
$stmt = $pdo->prepare("SELECT l.*, c.instructor_email, c.instructor_id, c.title as course_title FROM lessons l JOIN courses c ON l.course_id = c.id WHERE l.id = ?");
$stmt->execute([$lesson_id]);
$lesson = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$lesson) {
    die($isAr ? "الدرس غير موجود." : "Lesson not found.");
}

$isOwner = ($userRole === 'admin' || ($curUser['is_admin'] ?? 0) == 1 || $lesson['instructor_email'] === $userEmail || $lesson['instructor_id'] == $_SESSION['user_id']);
if (!$isOwner) {
    die($isAr ? "غير مسموح لك بتعديل هذا الدرس." : "You are not authorized to edit this lesson.");
}

$success_msg = '';
$error_msg = '';

// معالجة الحذف السريع للملفات المرتبطة من جدول الملحقات
if (isset($_GET['delete_attachment'])) {
    $att_id = (int)$_GET['delete_attachment'];
    $att_stmt = $pdo->prepare("SELECT * FROM lesson_attachments WHERE id = ? AND lesson_id = ?");
    $att_stmt->execute([$att_id, $lesson_id]);
    $att_file = $att_stmt->fetch(PDO::FETCH_ASSOC);
    
    if ($att_file) {
        if (file_exists(__DIR__ . '/' . $att_file['file_path'])) {
            @unlink(__DIR__ . '/' . $att_file['file_path']);
        }
        $del_stmt = $pdo->prepare("DELETE FROM lesson_attachments WHERE id = ?");
        $del_stmt->execute([$att_id]);
        header("Location: edit_lesson.php?id=" . $lesson_id);
        exit();
    }
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $title           = trim($_POST['title'] ?? '');
    $video_file      = trim($_POST['video_file'] ?? '');
    $content         = trim($_POST['content'] ?? '');
    $is_free_preview = isset($_POST['is_free_preview']) ? 1 : 0;
    
    $attachment_file = $lesson['attachment_file'] ?? null;

    if (empty($title)) {
        $error_msg = $isAr ? "عنوان الدرس مطلوب." : "Lesson title is required.";
    } else {
        try {
            // معالجة رفع ملف الملحقات الجديد داخل مجلد uploads
            if (isset($_FILES['attachment']) && $_FILES['attachment']['error'] === UPLOAD_ERR_OK) {
                $file_tmp  = $_FILES['attachment']['tmp_name'];
                $file_name = $_FILES['attachment']['name'];
                $file_ext  = strtolower(pathinfo($file_name, PATHINFO_EXTENSION));
                $allowed_exts = ['pdf', 'zip', 'rar', 'xlsx', 'docx', 'txt', 'csv'];

                if (in_array($file_ext, $allowed_exts)) {
                    $new_filename = 'attach_' . time() . '_' . mt_rand(1000, 9999) . '.' . $file_ext;
                    $upload_dir   = __DIR__ . '/uploads/';

                    if (!is_dir($upload_dir)) {
                        mkdir($upload_dir, 0777, true);
                    }

                    if (move_uploaded_file($file_tmp, $upload_dir . $new_filename)) {
                        $attachment_file = 'uploads/' . $new_filename;
                        
                        // محاولة الإضافة للجدول الجديد إن وجد
                        try {
                            $ins_att = $pdo->prepare("INSERT INTO lesson_attachments (lesson_id, file_path, file_name) VALUES (?, ?, ?)");
                            $ins_att->execute([$lesson_id, $attachment_file, $file_name]);
                        } catch (Exception $ex) {}
                    }
                }
            }

            // تحديث بيانات الدرس الأساسية
            $update_stmt = $pdo->prepare("UPDATE lessons SET title = ?, video_file = ?, content = ?, is_free_preview = ?, attachment_file = ? WHERE id = ?");
            $update_stmt->execute([$title, $video_file, $content, $is_free_preview, $attachment_file, $lesson_id]);
            
            $success_msg = $isAr ? "تم تحديث الدرس وملحقاته بنجاح!" : "Lesson updated successfully!";
            
            // إعادة جلب البيانات المحدثة
            $stmt->execute([$lesson_id]);
            $lesson = $stmt->fetch(PDO::FETCH_ASSOC);
        } catch (Exception $e) {
            try {
                $fallback_stmt = $pdo->prepare("UPDATE lessons SET title = ?, video_file = ? WHERE id = ?");
                $fallback_stmt->execute([$title, $video_file, $lesson_id]);
                $success_msg = $isAr ? "تم تحديث الدرس بنجاح!" : "Lesson updated successfully!";
                $stmt->execute([$lesson_id]);
                $lesson = $stmt->fetch(PDO::FETCH_ASSOC);
            } catch (Exception $ex) {
                $error_msg = "Error updating lesson: " . $ex->getMessage();
            }
        }
    }
}

// جلب الملحقات من الجدول الجديد إن وجد
$attachments = [];
try {
    $att_query = $pdo->prepare("SELECT * FROM lesson_attachments WHERE lesson_id = ?");
    $att_query->execute([$lesson_id]);
    $attachments = $att_query->fetchAll(PDO::FETCH_ASSOC);
} catch (Exception $e) {}

$pageTitle = $isAr ? "تعديل الدرس" : "Edit Lesson";
require_once __DIR__ . '/includes/header.php';
?>

